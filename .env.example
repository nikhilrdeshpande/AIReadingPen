# Copy to .env. Never commit .env.
# USB bridge (python3 firmware/GanapatiCam/usb_feed.py) serves both endpoints on :8080.
CAMERA_PREVIEW_URL=http://localhost:8080/stream
CAMERA_SNAPSHOT_URL=http://localhost:8080/capture
CAMERA_HMIRROR=true
CAMERA_VFLIP=false
# Wi-Fi firmware instead:
# CAMERA_PREVIEW_URL=http://192.168.4.1:81/stream
# CAMERA_SNAPSHOT_URL=http://192.168.4.1/capture
# CAMERA_STATUS_URL=http://192.168.4.1/status
DEMO_LANGUAGE=mr
AUTO_CAPTURE_ENABLED=true
PREVIEW_SAMPLE_MS=200
STABLE_DWELL_MS=750
MOTION_THRESHOLD=10
SHARPNESS_THRESHOLD=5
TEXT_OCCUPANCY_MIN=0.03
TEXT_OCCUPANCY_MAX=0.30
EXPOSURE_MIN=120
REARM_CHANGE_MS=400
MIN_CAPTURE_COOLDOWN_MS=2000
OCR_ENGINE=paddle
OCR_CONFIDENCE_THRESHOLD=0.80
OPEN_VOCABULARY=true
OPEN_VOCAB_CONFIDENCE_THRESHOLD=0.90
OPEN_VOCAB_VALIDATE=true
LESSON_MANIFEST=content/lessons.yaml
AUDIO_CACHE_DIR=content/audio
ENABLE_LIVE_TTS=true
SARVAM_VOICE=priya
SARVAM_TEMPERATURE=0.6
SARVAM_API_KEY=
OPENAI_API_KEY=
LESSON_STYLE=barakhadi
LESSON_SCRIPT_LLM=false
PRACTICE_ENABLED=true
PRACTICE_SECONDS=3
MIC_DEVICE=MacBook
DEBUG_SAVE_FRAMES=true
PORT=8000
